together {
  class "references" as n_archive_seminar_essay_materials_papers_references
  class "subject" as n_archive_seminar_essay_materials_papers_subject
}
n_archive_seminar_essay_materials_papers_references .up.> n_archive_seminar_essay_materials_papers
n_archive_seminar_essay_materials_papers_subject .up.> n_archive_seminar_essay_materials_papers
n_archive_seminar_essay_materials_task .up.> n_archive_seminar_essay_materials
n_archive_seminar_essay_skeleton .up.> n_archive_seminar_essay
n_archive_seminar_essay_style .up.> n_archive_seminar_essay
together {
  class "ai_pattern" as n_archive_seminar_essay_style_ai_pattern
  class "voice" as n_archive_seminar_essay_style_voice
}
