@startuml
class "topology" as topology
together {
  class "archive" as n_archive
  class "phd_application" as n_phd_application
  class "seminar_essay" as n_seminar_essay
  class "thesis" as n_thesis
}
n_archive .up.> topology
together {
  class "coding" as n_archive_coding
  class "seminar_essay" as n_archive_seminar_essay
}
n_archive_coding .up.> n_archive
together {
  class "blueprint" as n_archive_coding_blueprint
  class "spec" as n_archive_coding_spec
}
n_archive_coding_blueprint .up.> n_archive_coding
n_archive_coding_spec .up.> n_archive_coding
together {
  class "app" as n_archive_coding_spec_app
}
n_archive_coding_spec_app .up.> n_archive_coding_spec
n_archive_seminar_essay .up.> n_archive
together {
  class "analysis" as n_archive_seminar_essay_analysis
