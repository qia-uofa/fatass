  class "materials" as n_seminar_essay_materials
}
n_seminar_essay_materials .up.> n_seminar_essay
together {
  class "analysis" as n_seminar_essay_materials_analysis
  class "drafting" as n_seminar_essay_materials_drafting
  class "papers" as n_seminar_essay_materials_papers
