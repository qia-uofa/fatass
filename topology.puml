}
n_seminar_essay_materials_papers_metadata .up.> n_seminar_essay_materials_papers
n_seminar_essay_materials_papers_pdf .up.> n_seminar_essay_materials_papers
n_seminar_essay_materials_papers_sidenote .up.> n_seminar_essay_materials_papers
n_seminar_essay_materials_patterns .up.> n_seminar_essay_materials
n_thesis .up.> topology
together {
  class "brainstorm" as n_thesis_brainstorm
}
n_thesis_brainstorm .up.> n_thesis

class "None" as none_node

n_archive_coding_spec -[bold]right-> n_archive_coding_blueprint
none_node -[bold]-> n_archive_coding_spec_app
n_archive_seminar_essay_materials_papers -[bold]right-> n_archive_seminar_essay_analysis_references
n_archive_seminar_essay_materials_papers_subject -[bold]right-> n_archive_seminar_essay_analysis_subject
n_archive_seminar_essay_materials_task -[bold]right-> n_archive_seminar_essay_analysis_task
n_archive_seminar_essay_drafting_draft -[bold]right-> n_archive_seminar_essay_audit_draft
n_archive_seminar_essay_drafting_annotation -[bold]right-> n_archive_seminar_essay_audit_draft
n_archive_seminar_essay_audit_draft -[bold]right-> n_archive_seminar_essay_audit_draft_star
n_archive_seminar_essay_audit_issues -[bold]right-> n_archive_seminar_essay_audit_draft_star
n_archive_seminar_essay_drafting_draft -[bold]right-> n_archive_seminar_essay_drafting_annotation
n_archive_seminar_essay_style_ai_pattern -[bold]right-> n_archive_seminar_essay_drafting_annotation
n_archive_seminar_essay_skeleton -[bold]right-> n_archive_seminar_essay_drafting_draft
n_archive_seminar_essay_style -[bold]right-> n_archive_seminar_essay_drafting_draft
n_archive_seminar_essay_materials -[bold]right-> n_archive_seminar_essay_drafting_draft
n_archive_seminar_essay_analysis -[bold]right-> n_archive_seminar_essay_skeleton
n_phd_application_pool_unis -[bold]right-> n_phd_application_pool_profs
none_node --> n_phd_application_pool_unis : search
n_seminar_essay_materials_papers -[bold]right-> n_seminar_essay_materials_analysis
n_seminar_essay_materials_drafting_parts -[bold]right-> n_seminar_essay_materials_drafting_draft
n_seminar_essay_materials_drafting_structure -[bold]right-> n_seminar_essay_materials_drafting_parts
n_seminar_essay_materials_analysis -[bold]right-> n_seminar_essay_materials_drafting_parts
n_seminar_essay_materials_papers -[bold]right-> n_seminar_essay_materials_drafting_parts
