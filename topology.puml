together {
  class "facts" as n_seminar_essay_materials_analysis_facts
  class "interconnection" as n_seminar_essay_materials_analysis_interconnection
  class "intraconnection" as n_seminar_essay_materials_analysis_intraconnection
  class "summary" as n_seminar_essay_materials_analysis_summary
}
n_seminar_essay_materials_analysis_facts .up.> n_seminar_essay_materials_analysis
n_seminar_essay_materials_analysis_interconnection .up.> n_seminar_essay_materials_analysis
n_seminar_essay_materials_analysis_intraconnection .up.> n_seminar_essay_materials_analysis
n_seminar_essay_materials_analysis_summary .up.> n_seminar_essay_materials_analysis
n_seminar_essay_materials_drafting .up.> n_seminar_essay_materials
together {
  class "draft" as n_seminar_essay_materials_drafting_draft
  class "parts" as n_seminar_essay_materials_drafting_parts
  class "structure" as n_seminar_essay_materials_drafting_structure
  class "task" as n_seminar_essay_materials_drafting_task
